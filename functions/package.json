{
  "name": "functions",
  "version": "1.0.0",
  "description": "ゴルフマッチングアプリ サーバーサイド（Cloud Functions for Firebase, TypeScript）",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "deploy:all": "firebase deploy --only functions,firestore:rules,firestore:indexes",
    "logs": "firebase functions:log",
    "seed:areas": "npm run build && node lib/scripts/seedAreas.js",
    "test": "firebase emulators:exec --only firestore --project golf-app-dev-placeholder \"jest --runInBand\"",
    "test:watch": "echo \"別ターミナルでFirestore Emulatorを起動した状態(firebase emulators:start --only firestore --project golf-app-dev-placeholder)で、FIRESTORE_EMULATOR_HOST=localhost:8080 jest --watch を実行してください\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0",
    "twilio": "^6.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "firebase-tools": "^13.35.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.6.3"
  }
}
