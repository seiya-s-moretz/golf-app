# Twilio認証情報（技術設計書12-5章、ADR-0008）。
# ローカル開発でのみこのファイルを`.env`にコピーして実値を設定する（`.env`はgit管理外）。
# デプロイ環境では`.env`ではなくCloud FunctionsのシークレットSecret Managerで管理する:
#   firebase functions:secrets:set TWILIO_ACCOUNT_SID
#   firebase functions:secrets:set TWILIO_AUTH_TOKEN
#   firebase functions:secrets:set TWILIO_FROM_NUMBER
# 詳細な手順はfunctions/README.md「Twilio（実SMS送信）の設定」を参照。
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# 送信元電話番号。TwilioコンソールのE.164形式（例: +15551234567）
TWILIO_FROM_NUMBER=

# SMS送信実装の明示的な切り替え（console|twilio）。
# 未設定の場合、Emulator実行時（FUNCTIONS_EMULATOR=true）は自動的にConsoleSmsSenderが、
# それ以外（デプロイ環境）ではTwilioSmsSenderが選択される。
# ローカルで実SMS送信を試す場合のみ`twilio`を指定する（Emulatorでも実際にSMSが送信され課金される点に注意）。
SMS_PROVIDER=
